# ArchPrompt Studio — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Base44 application id (from the Base44 builder)
VITE_BASE44_APP_ID=your_app_id

# Base44 backend base URL (e.g. https://your-app-xxxxxxxx.base44.app)
VITE_BASE44_APP_BASE_URL=your_backend_url

# Optional: pin a specific Base44 functions version
# VITE_BASE44_FUNCTIONS_VERSION=
